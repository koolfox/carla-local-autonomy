# Local machine configuration for `uv run carla-operator-ui --open-browser`.
# Copy this file to `.env.local`; the real file is ignored by Git.

CARLA_HOST='192.168.1.108'
CARLA_PORT='2000'

# Loopback only: 127.0.0.1
# macOS LAN access: 0.0.0.0, then browse to http://<mac-lan-ip>:8765/
CARLA_OPERATOR_BIND='0.0.0.0'
CARLA_OPERATOR_PORT='8765'
CARLA_WORKSPACE='.'
CARLA_OPERATOR_SESSIONS_ROOT='operator_sessions'

# Optional World Worker. Use a raw URL, not Markdown link syntax.
CARLA_WORLD_WORKER_URL='http://192.168.1.108:8766'
CARLA_WORLD_WORKER_PORT='8766'
CARLA_WORLD_WORKER_TOKEN='replace-with-local-secret'

# Opt-in Garage research/autonomy jobs.
CARLA_ENABLE_EXPERIMENTAL='false'

# Browser default only; runtime frame sequence/state is never configured here.
detector.enabled=true
