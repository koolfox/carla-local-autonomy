# CARLA Operator local configuration
# Copy to .env.local and edit for your machine.

CARLA_HOST=auto
CARLA_PORT=2000
CARLA_OPERATOR_BIND=127.0.0.1
CARLA_OPERATOR_PORT=8765
CARLA_WORKSPACE=.
CARLA_OPERATOR_SESSIONS_ROOT=operator_sessions

# Optional World Worker
# CARLA_WORLD_WORKER_URL=auto
# CARLA_WORLD_WORKER_PORT=8766
# CARLA_WORLD_WORKER_TOKEN=replace-me

# Experimental Garage autonomy/research jobs
CARLA_ENABLE_EXPERIMENTAL=0
