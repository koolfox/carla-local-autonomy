carla_vision/operator/console_static/** -whitespace linguist-generated=true
# Historical payloads and their checksums must retain exact original bytes.
samples/** -text
samples/data/** -whitespace
samples/historical-reports/** -whitespace
samples/model-labels/** -whitespace
samples/recordings/** -whitespace
# Bundled model weights live in GitHub LFS and hydrate on an LFS-enabled clone.
models/** -text
models/notices/** -whitespace
models/**/*.csv -whitespace
models/**/*.pt filter=lfs diff=lfs merge=lfs -text
models/**/*.onnx filter=lfs diff=lfs merge=lfs -text
models/**/*.bin filter=lfs diff=lfs merge=lfs -text
models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
# Setup archives and checksum bytes are portable across clone line-ending settings.
installers/*.zip -text
installers/*.tar.gz -text
installers/checksums.sha256 text eol=lf
# Documentation screenshots are binary.
docs/images/** -text
